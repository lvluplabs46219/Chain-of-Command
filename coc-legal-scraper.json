{
  "_id": "coc_legal_corpus_scraper",
  "startUrl": [
    "https://www.azcourts.gov/selfservicecenter/Self-Service-Forms"
  ],
  "selectors": [
    {
      "id": "category",
      "type": "SelectorLink",
      "parentSelectors": ["_root"],
      "selector": "a.category-link",
      "multiple": true,
      "delay": 2000
    },
    {
      "id": "sub_category",
      "type": "SelectorLink",
      "parentSelectors": ["category", "sub_category"],
      "selector": "a.sub-category-link, a.page-link",
      "multiple": true,
      "delay": 2000
    },
    {
      "id": "document_title",
      "type": "SelectorText",
      "parentSelectors": ["sub_category"],
      "selector": "h1, h2.title",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "document_content",
      "type": "SelectorText",
      "parentSelectors": ["sub_category"],
      "selector": "div.article-content, div.form-body",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "pdf_download_link",
      "type": "SelectorAttribute",
      "parentSelectors": ["sub_category"],
      "selector": "a[href$='.pdf']",
      "extractAttribute": "href",
      "multiple": true,
      "delay": 0
    }
  ]
}
