rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('role' in data) || (data.role in ['litigant', 'attorney', 'paralegal', 'admin']))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidMatter(data) {
      return data.keys().hasAll(['title', 'userId', 'status'])
        && data.keys().hasOnly(['title', 'userId', 'status', 'jurisdiction', 'courtName', 'caseNumber', 'description', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.userId is string && data.userId == request.auth.uid
        && data.status in ['open', 'active', 'pending', 'closed', 'archived']
        && (!('jurisdiction' in data) || (data.jurisdiction is string && data.jurisdiction.size() <= 100))
        && (!('courtName' in data) || (data.courtName is string && data.courtName.size() <= 200))
        && (!('caseNumber' in data) || (data.caseNumber is string && data.caseNumber.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTimelineEvent(data, matterId) {
      return data.keys().hasAll(['matterId', 'userId', 'title', 'eventType'])
        && data.keys().hasOnly(['matterId', 'userId', 'title', 'eventType', 'eventDate', 'description', 'createdAt'])
        && data.matterId == matterId
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.eventType in ['hearing', 'filing_deadline', 'discovery_deadline', 'arrest', 'general', 'appearance', 'motion', 'order', 'plea']
        && (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 64))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidCaseDocument(data, matterId) {
      return data.keys().hasAll(['matterId', 'userId', 'title', 'type', 'status'])
        && data.keys().hasOnly(['matterId', 'userId', 'title', 'type', 'status', 'extractedText', 'aiSummary', 'createdAt'])
        && data.matterId == matterId
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.type in ['filing', 'evidence', 'order', 'correspondence', 'transcript', 'motion', 'brief', 'memo']
        && data.status in ['draft', 'review', 'approved', 'filed', 'archived']
        && (!('extractedText' in data) || (data.extractedText is string && data.extractedText.size() <= 50000))
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 5000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidEvidenceItem(data, matterId) {
      return data.keys().hasAll(['matterId', 'userId', 'title'])
        && data.keys().hasOnly(['matterId', 'userId', 'title', 'description', 'dateAcquired', 'relevanceScore', 'createdAt'])
        && data.matterId == matterId
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('dateAcquired' in data) || (data.dateAcquired is string && data.dateAcquired.size() <= 64))
        && (!('relevanceScore' in data) || (data.relevanceScore is number))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Match collections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /matters/{matterId} {
      allow get: if isSignedIn() && isValidId(matterId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(matterId) && isValidMatter(incoming());
      allow update: if isSignedIn() && isValidId(matterId) && resource.data.userId == request.auth.uid
        && isValidMatter(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'jurisdiction', 'courtName', 'caseNumber', 'status', 'description', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(matterId) && resource.data.userId == request.auth.uid;

      match /timeline_events/{eventId} {
        allow get: if isSignedIn() && isValidId(eventId) && resource.data.userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(eventId) && isValidTimelineEvent(incoming(), matterId);
        allow update: if isSignedIn() && isValidId(eventId) && resource.data.userId == request.auth.uid
          && isValidTimelineEvent(incoming(), matterId)
          && incoming().userId == existing().userId
          && incoming().matterId == existing().matterId
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'eventType', 'eventDate', 'description']);
        allow delete: if isSignedIn() && isValidId(eventId) && resource.data.userId == request.auth.uid;
      }

      match /documents/{documentId} {
        allow get: if isSignedIn() && isValidId(documentId) && resource.data.userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(documentId) && isValidCaseDocument(incoming(), matterId);
        allow update: if isSignedIn() && isValidId(documentId) && resource.data.userId == request.auth.uid
          && isValidCaseDocument(incoming(), matterId)
          && incoming().userId == existing().userId
          && incoming().matterId == existing().matterId
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'status', 'extractedText', 'aiSummary']);
        allow delete: if isSignedIn() && isValidId(documentId) && resource.data.userId == request.auth.uid;
      }

      match /evidence/{evidenceId} {
        allow get: if isSignedIn() && isValidId(evidenceId) && resource.data.userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(evidenceId) && isValidEvidenceItem(incoming(), matterId);
        allow update: if isSignedIn() && isValidId(evidenceId) && resource.data.userId == request.auth.uid
          && isValidEvidenceItem(incoming(), matterId)
          && incoming().userId == existing().userId
          && incoming().matterId == existing().matterId
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'dateAcquired', 'relevanceScore']);
        allow delete: if isSignedIn() && isValidId(evidenceId) && resource.data.userId == request.auth.uid;
      }
    }
  }
}
