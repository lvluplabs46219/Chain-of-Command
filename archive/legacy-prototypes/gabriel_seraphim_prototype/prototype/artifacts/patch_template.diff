-    return template
+def render_template(template: str, context: dict) -> str:
+    "Safe template renderer - escapes context values."
+    import html
+    for key, value in context.items():
+        safe = html.escape(str(value))
+        template = template.replace(f"{{{{{key}}}}}", safe)
+    return template
