# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript and JavaScript files
[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 100

# JSON files
[*.{json,jsonc}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# CSS and related files
[*.{css,scss,less,pcss,postcss}]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# Package files
[{package.json,package-lock.json}]
indent_size = 2

# Configuration files
[*.{config.js,config.ts}]
indent_size = 2

# Makefile requires tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = tab
indent_size = 4
