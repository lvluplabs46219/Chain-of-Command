{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install",
      "type": "npm",
      "script": "install",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm install (web)",
      "type": "npm",
      "script": "install",
      "path": "apps/web",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "npm install (api)",
      "type": "npm",
      "script": "install",
      "path": "apps/api",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "dev: web",
      "type": "npm",
      "script": "dev",
      "path": "apps/web",
      "group": "test",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^(.*:)*ERROR.*$",
              "file": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Ready in",
            "endsPattern": "compiled|Compiled|Failed"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "echo": false
      }
    },
    {
      "label": "dev: api",
      "type": "npm",
      "script": "dev",
      "path": "apps/api",
      "group": "test",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "echo": false
      }
    },
    {
      "label": "build: web",
      "type": "npm",
      "script": "build",
      "path": "apps/web",
      "group": "build",
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^(.*:)*ERROR.*$",
              "file": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Building",
            "endsPattern": "Export|Exported|Failed"
          }
        }
      ],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "build: api",
      "type": "npm",
      "script": "build",
      "path": "apps/api",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "lint: web",
      "type": "npm",
      "script": "lint",
      "path": "apps/web",
      "group": "test",
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^.*\((.*):(\d+):(\d+)\)$",
              "file": 1,
              "line": 2,
              "column": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Checking",
            "endsPattern": "Found|No errors"
          }
        }
      ]
    },
    {
      "label": "typecheck: web",
      "type": "npm",
      "script": "typecheck",
      "path": "apps/web",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "typecheck: api",
      "type": "npm",
      "script": "typecheck",
      "path": "apps/api",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: api",
      "type": "npm",
      "script": "test",
      "path": "apps/api",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "dev: all",
      "dependsOn": ["dev: api", "dev: web"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "start: web",
      "type": "npm",
      "script": "start",
      "path": "apps/web",
      "group": "none",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "start: api",
      "type": "npm",
      "script": "start",
      "path": "apps/api",
      "group": "none",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
