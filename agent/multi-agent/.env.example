# Multi-Agent Runtime — environment
# Copy to .env and fill in values:
#   cp .env.example .env

# ── LLM provider cascade ──────────────────────────────────────────────
# Auto order: lemonade → ollama-cloud → ollama (local)
# Force one: lemonade | ollama-cloud | ollama
LLM_PROVIDER=

# Lemonade Server (local GPU/NPU) — https://lemonade-server.ai
LEMONADE_URL=http://127.0.0.1:13305
LEMONADE_MODEL=Qwen2.5-7B-Instruct-GGUF

# Ollama Cloud — https://ollama.com
# Create key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com

# ── Per-agent free-tier / popular cloud models ─────────────────────────
# YHWH     planning / multilingual agent workflows
YHWH_CLOUD_MODEL=nemotron-3-super
# Michael  orchestration, tool-use, thinking
MICHAEL_CLOUD_MODEL=gpt-oss:120b
# Gabriel  messaging / general (general)
GABRIEL_CLOUD_MODEL=gemma4:31b
# Raphael  task bots + code repair
RAPHAEL_CLOUD_MODEL=qwen3-coder:480b
# Metatron model gateway default reasoning
METATRON_CLOUD_MODEL=kimi-k2.5
# Seraphim heavy research path (when not on Vertex)
SERAPHIM_CLOUD_MODEL=glm-5
# Vision / document parsing
VISION_CLOUD_MODEL=qwen3-vl:235b
# Explicit coding slot
CODER_CLOUD_MODEL=qwen3-coder:480b

# Optional global override (overrides all slots if set):
# OLLAMA_CLOUD_MODEL=

# Local Ollama daemon (optional fallback)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Agent runtime ─────────────────────────────────────────────────────
MICHAEL_SOCK=/tmp/coc-michael.sock
RAPHAEL_WORKSPACE=.

# External Vertex AI pool (off by default)
SERAPHIM_ENABLED=false
# SERAPHIM_PROJECT=
# SERAPHIM_LOCATION=us-central1
# SERAPHIM_MODEL=gemini-2.0-flash
# GOOGLE_APPLICATION_CREDENTIALS=
