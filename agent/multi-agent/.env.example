# Multi-Agent Runtime — environment
# cp .env.example .env

# Agents use Ollama Cloud free models (NOT Lemonade).
LLM_PROVIDER=ollama-cloud

# Required — https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com

# Per-agent Ollama Cloud models (free / popular tier)
YHWH_CLOUD_MODEL=nemotron-3-super
MICHAEL_CLOUD_MODEL=gpt-oss:120b
GABRIEL_CLOUD_MODEL=gemma4:31b
RAPHAEL_CLOUD_MODEL=qwen3-coder:480b
METATRON_CLOUD_MODEL=kimi-k2.5
SERAPHIM_CLOUD_MODEL=glm-5
VISION_CLOUD_MODEL=qwen3-vl:235b
CODER_CLOUD_MODEL=qwen3-coder:480b

# Optional fallbacks only if you set LLM_PROVIDER=auto or ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# LEMONADE_URL=http://127.0.0.1:13305
# LEMONADE_MODEL=DeepSeek-Qwen3-8B-GGUF

MICHAEL_SOCK=/tmp/coc-michael.sock
RAPHAEL_WORKSPACE=.
SERAPHIM_ENABLED=false
