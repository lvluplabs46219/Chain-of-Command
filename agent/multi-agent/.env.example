# Multi-Agent Runtime — environment
# Copy to .env and fill in values:
#   cp .env.example .env

# ── LLM provider cascade ──────────────────────────────────────────────
# Auto order: lemonade → ollama-cloud → ollama (local)
# Force one: lemonade | ollama-cloud | ollama
LLM_PROVIDER=

# Lemonade Server (local GPU/NPU) — https://lemonade-server.ai
LEMONADE_URL=http://127.0.0.1:13305
LEMONADE_MODEL=Qwen2.5-7B-Instruct-GGUF

# Ollama Cloud (free tier) — https://ollama.com
# Create key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com
# Free-tier friendly models (pick one):
#   gpt-oss:20b          — fast, solid coding
#   gpt-oss:120b         — stronger reasoning (uses more free credits)
#   gemma4:31b           — strong general
#   nemotron-3-nano      — very fast
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# Local Ollama daemon (optional fallback)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Agent runtime ─────────────────────────────────────────────────────
MICHAEL_SOCK=/tmp/coc-michael.sock
RAPHAEL_WORKSPACE=.

# External Vertex AI pool (off by default)
SERAPHIM_ENABLED=false
# SERAPHIM_PROJECT=
# SERAPHIM_LOCATION=us-central1
# SERAPHIM_MODEL=gemini-2.0-flash
# GOOGLE_APPLICATION_CREDENTIALS=
