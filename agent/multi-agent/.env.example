# Multi-Agent Runtime — environment
# Copy to .env and fill in values:
#   cp .env.example .env

# ── LLM provider cascade ──────────────────────────────────────────────
# Auto order: lemonade → ollama-cloud → ollama (local)
# Force one: lemonade | ollama-cloud | ollama
LLM_PROVIDER=

# Lemonade Server (local) — must be running: lemonade-server serve
LEMONADE_URL=http://127.0.0.1:13305
# Global fallback if a per-agent slot is unset
LEMONADE_MODEL=DeepSeek-Qwen3-8B-GGUF

# Per-agent Lemonade models (from your `lemonade list` — all installed)
YHWH_LEMONADE_MODEL=DeepSeek-Qwen3-8B-GGUF
MICHAEL_LEMONADE_MODEL=Llama-3.2-3B-Instruct-GGUF
GABRIEL_LEMONADE_MODEL=Llama-3.2-1B-Instruct-GGUF
RAPHAEL_LEMONADE_MODEL=Qwen3.5-4B-MTP-GGUF
METATRON_LEMONADE_MODEL=DeepSeek-Qwen3-8B-GGUF
SERAPHIM_LEMONADE_MODEL=DeepSeek-Qwen3-8B-GGUF
VISION_LEMONADE_MODEL=LMX-Omni-5.5B-Lite
CODER_LEMONADE_MODEL=Qwen3.5-4B-MTP-GGUF

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com

# Per-agent Ollama Cloud free-tier models
YHWH_CLOUD_MODEL=nemotron-3-super
MICHAEL_CLOUD_MODEL=gpt-oss:120b
GABRIEL_CLOUD_MODEL=gemma4:31b
RAPHAEL_CLOUD_MODEL=qwen3-coder:480b
METATRON_CLOUD_MODEL=kimi-k2.5
SERAPHIM_CLOUD_MODEL=glm-5
VISION_CLOUD_MODEL=qwen3-vl:235b
CODER_CLOUD_MODEL=qwen3-coder:480b

# Local Ollama daemon (optional third fallback)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Agent runtime ─────────────────────────────────────────────────────
MICHAEL_SOCK=/tmp/coc-michael.sock
RAPHAEL_WORKSPACE=.

SERAPHIM_ENABLED=false
