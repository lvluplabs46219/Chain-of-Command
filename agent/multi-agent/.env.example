# ---- GitHub automation watcher (npm run watch:github) ----
# Repository the agents watch for failed workflow runs / "agent"-labeled issues
GH_REPO=lvluplabs46219/Chain-of-Command
# Personal access token (repo scope) - strongly recommended; unauthenticated
# API allows only 60 requests/hour. Create one at:
# https://github.com/settings/tokens
GH_TOKEN=
WATCH_INTERVAL_MS=120000
WATCH_ISSUES=true
