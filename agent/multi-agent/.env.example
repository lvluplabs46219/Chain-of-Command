# ---- YHWH (local LLM via Ollama) ----
# Native Ollama default; set to http://host.docker.internal:11434 if the
# daemon runs inside Docker while Ollama runs on the host.
OLLAMA_URL=http://127.0.0.1:11434
YHWH_MODEL=qwen2.5:7b
YHWH_PROVIDER=ollama

# ---- Michael (orchestrator daemon) ----
# Unix Domain Socket the daemon listens on (Linux/macOS)
MICHAEL_SOCK=/tmp/coc-michael.sock
# SQLite state cache location (defaults to ~/.local/state/coc/state.db)
STATE_DB=

# ---- Optional: Supabase state sync ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Optional: Gabriel messengers ----
GABRIEL_WEBHOOKS=

# ---- Optional: Seraphim external pool (leave empty for 100% local) ----
SERAPHIM_ENABLED=false
SERAPHIM_LOCATION=
SERAPHIM_MODEL=
SERAPHIM_PROJECT=
SERAPHIM_RETRIES=
SERAPHIM_TIMEOUT_MS=
