    "worker": "node dist/cli/worker-cli.js",
    "send": "node dist/cli/send.js",
    "watch:github": "node dist/cli/watch-github.js",
    "watch": "node dist/cli/watch-github.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
