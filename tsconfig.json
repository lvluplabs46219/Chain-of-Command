{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@chain-of-command/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@chain-of-command/agent-sdk": ["./packages/agent-sdk/src/index.ts"],
      "@chain-of-command/legal-library": ["./packages/legal-library/src/index.ts"],
      "@chain-of-command/deadline-engine": ["./packages/deadline-engine/src/index.ts"],
      "@chain-of-command/shared": ["./packages/shared/src/index.ts"],
      "@chain-of-command/audit": ["./packages/audit/src/index.ts"],
      "@chain-of-command/model-gateway": ["./packages/model-gateway/src/index.ts"],
      "@chain-of-command/auth": ["./packages/auth/src/index.ts"],
      "@chain-of-command/rag-engine": ["./packages/rag-engine/src/index.ts"],
      "@chain-of-command/database": ["./packages/database/index.ts"]
    }
  },
  "include": ["apps/web/**/*", "packages/*/src/**/*"],
  "exclude": ["node_modules"]
}
