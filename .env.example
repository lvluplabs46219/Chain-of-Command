# Chain of Command Legal OS — environment template
# Copy to .env and fill in values. Never commit real secrets.

# ---- Local AI (Ollama) — PRIMARY LLM PROVIDER ----
# All /ai/* and legacy /gemini/* routes use Ollama only (no cloud Gemini).
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- CourtListener (Free Law Project) — case law + RECAP ----
# Token: https://www.courtlistener.com/profile/api/ (higher rate limits)
COURTLISTENER_API_TOKEN=
# Webhook HMAC for RECAP/docket alerts: https://www.courtlistener.com/help/api/webhooks/
# Endpoint to register: POST {API_URL}/api/webhooks/courtlistener
COURTLISTENER_WEBHOOK_SECRET=

# ---- API / App ----
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# ---- Database ----
DATABASE_URL=
STATE_DB=

# ---- Supabase (optional auth / storage) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Firebase (optional Google sign-in) ----
FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Multi-agent (Seraphim / Gabriel / YHWH) ----
SERAPHIM_ENABLED=
SERAPHIM_LOCATION=
SERAPHIM_MODEL=
SERAPHIM_PROJECT=
SERAPHIM_RETRIES=
SERAPHIM_TIMEOUT_MS=
GABRIEL_WEBHOOKS=
MICHAEL_SOCK=
YHWH_MODEL=
YHWH_PROVIDER=ollama

# ---- Rate limiting / cache (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Secrets manager (optional) ----
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_SLUG=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SERVICE_TOKEN=

# GEMINI_API_KEY is intentionally omitted — Chain of Command uses Ollama only.
