# =============================================================================
# Chain of Command Legal OS — environment template
# Copy to `.env` (repo root) and/or `apps/api/.env` + `apps/web/.env.local`
# Never commit real secrets.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Production: set explicit origins only (no wildcards), e.g.
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# Preview CORS for *.vercel.app in non-production only:
ALLOW_PREVIEW_CORS=true
# Demo / coc-session bearer tokens (NEVER true in production):
ALLOW_DEMO_AUTH=true

# ---- API / App URLs ----
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Local AI (Ollama) — PRIMARY LLM ----
# Used by /ai/* and legacy /gemini/* routes. No cloud Gemini required.
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional alias some scripts use:
OLLAMA_API=http://localhost:11434
YHWH_PROVIDER=ollama
YHWH_MODEL=llama3.2

# ---- CourtListener (Free Law Project) ----
# Case law search (opinions) + RECAP federal dockets
# Token: https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=
# Legacy alias (if set, API will accept either name):
COURT_LISTENER_API_KEY=
# Webhook HMAC for docket alerts: https://www.courtlistener.com/help/api/webhooks/
# Register: POST {API_URL}/api/webhooks/courtlistener
COURTLISTENER_WEBHOOK_SECRET=

# ---- Database ----
DATABASE_URL=
DIRECT_URL=
STATE_DB=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Supabase (auth / storage) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Firebase (optional Google sign-in) ----
FIREBASE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Optional model providers (not used for primary AI) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=   # intentionally unused — Ollama only

# ---- Webhooks / gates ----
DOXPOP_WEBHOOK_SECRET=
DOXPOP_SITEMAP_ID=
FILING_GATE_SECRET=
GATE_HMAC_SECRET=
HUMAN_GATE_HMAC_SECRET=
CHAIN_SIGNING_SECRET=

# ---- Rate limiting / cache ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional integrations ----
PINATA_JWT=
WEBSCRAPER_API_KEY=
HF_S3_ACCESS_KEY=
HF_S3_SECRET_KEY=

# ---- Multi-agent (Seraphim / Gabriel) ----
SERAPHIM_ENABLED=
SERAPHIM_LOCATION=
SERAPHIM_MODEL=
SERAPHIM_PROJECT=
SERAPHIM_RETRIES=
SERAPHIM_TIMEOUT_MS=
GABRIEL_WEBHOOKS=
MICHAEL_SOCK=

# ---- Secrets manager (optional) ----
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_SLUG=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SERVICE_TOKEN=

# ---- Dev / flags ----
USE_MOCK_PERSISTENCE=
LOG_LEVEL=info
DEBUG=
