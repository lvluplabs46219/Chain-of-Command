# Chain of Command — environment template (safe to commit)
# Copy to apps/web/.env.local and apps/api/.env and fill values.

# Supabase (Chain of Command project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server only; never expose to browser

# Local LLM (preferred for privacy)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
YHWH_MODEL=llama3.2:latest
LLM_DEFAULT_PROVIDER=ollama

# Optional cloud providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# App
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_ALLOW_DEMO_AUTH=true
