{
  "name": "chain-of-command",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "true",
    "dev": "npm --prefix apps/web run dev",
    "dev:wire": "npm --prefix apps/empyrean run dev",
    "dev:empyrean": "npm run dev:wire",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "start": "npm --prefix apps/web run start",
    "secrets:agent": "infisical agent --config config/infisical/agent-config.yaml",
    "secrets:agent:root": "infisical agent --config agent-config.yaml",
    "dev:all": "echo \"Start The Wire (:3100) + Web (:3000).\" && npm run dev:wire & npm run dev",
    "dev:stack": "npm run dev:wire",
    "worker:dev": "npm --prefix apps/worker run dev",
    "worker:deploy": "npm --prefix apps/worker run deploy"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.1"
  }
}
