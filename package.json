{
  "name": "chain-of-command",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev apps/web -p 3000 -H 0.0.0.0",
    "build": "next build apps/web",
    "start": "next start apps/web -p 3000 -H 0.0.0.0",
    "secrets:agent": "infisical agent --config config/infisical/agent-config.yaml",
    "secrets:agent:root": "infisical agent --config agent-config.yaml"
  },
  "dependencies": {
    "ai": "^7.0.138",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
